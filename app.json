{
  "expo": {
    "name": "Veronica Lens",
    "slug": "veronica-lens-mobile",
    "scheme": "veronicalens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Permita que o VeronicaLens use a câmera para capturas astronômicas assistidas."
      }
    },
    "android": {
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#080B14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veronicalens.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "60f28b96-eadb-4939-ad56-ce5cb4279b5a"
      }
    },
    "owner": "eulorenzini",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      "@react-native-vector-icons/lucide",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o VeronicaLens use sua localização para calcular os objetos visíveis no céu."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Permita que o VeronicaLens use o movimento do aparelho para alinhar o guia celeste ao céu."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o VeronicaLens acesse suas fotos para definir a foto de perfil."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
