+  val red = if (t <= 66.0) 255.0 else 329.698727446 * (t - 60.0).pow(-0.1332047592)
+  val green =
+    if (t <= 66.0) {
+      99.4708025861 * ln(t) - 161.1195681661
+    } else {
+      288.1221695283 * (t - 60.0).pow(-0.0755148492)
+    }
+  val blue =
+    when {
+      t >= 66.0 -> 255.0
+      t <= 19.0 -> 0.0
+      else -> 138.5177312231 * ln(t - 10.0) - 305.0447927307
+    }
+  val r = (red.coerceIn(0.0, 255.0) / 255.0).coerceAtLeast(0.2)
+  val g = (green.coerceIn(0.0, 255.0) / 255.0).coerceAtLeast(0.2)
+  val b = (blue.coerceIn(0.0, 255.0) / 255.0).coerceAtLeast(0.2)
+  val brightest = maxOf(r, g, b)
+  return WhiteBalanceGains(redGain = brightest / r, blueGain = brightest / b, greenGain = brightest / g)
